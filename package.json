{
  "name": "edgessh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Zero Trust protected WebSSH workspace with encrypted D1 host storage",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.frontend.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "node --test --experimental-strip-types --experimental-sqlite tests/*.test.ts",
    "test:browser": "playwright test",
    "showcase": "node scripts/generate-showcase.mjs",
    "check": "npm run typecheck && npm run test && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy:validate": "node --experimental-strip-types scripts/deploy.ts --validate-only",
    "deploy": "node --experimental-strip-types scripts/deploy.ts",
    "test:cli": "npm --prefix cli test",
    "test:cli:ssh": "node --test tests/cli-ssh.integration.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "jose": "^6.2.12",
    "lucide": "^1.51.0",
    "mappo": "^0.3.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^15.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "flag-icons": "^7.5.0",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "wrangler": "^4.134.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
